{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/log_event.ps1"
      },
      {
        "type": "command",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/inject_memory.ps1"
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/log_event.ps1"
      },
      {
        "type": "command",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/inject_memory.ps1"
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/log_event.ps1"
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/log_event.ps1"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/log_event.ps1"
      }
    ]
  }
}
